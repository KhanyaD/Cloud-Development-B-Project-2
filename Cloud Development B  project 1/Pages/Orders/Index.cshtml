@page
@model Cloud_Development_B__project_1.Pages.Orders.IndexModel

@{
    ViewData["Title"] = "Orders";
}

<div class="container mt-4">

    <div class="mb-4">

        <h1 class="display-6 fw-bold">
            <i class="bi bi-cart-check text-primary"></i>
            Order Management
        </h1>

        <p class="lead">
            Create orders using Azure Table Storage and send
            order messages to Azure Queue Storage.
        </p>

    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @Model.SuccessMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @Model.ErrorMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <div class="card mb-4">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">
                Create New Order
            </h5>

        </div>

        <div class="card-body">

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row g-3">

                    <!-- CUSTOMER -->
                    <div class="col-md-6">

                        <label asp-for="Order.CustomerName"
                               class="form-label">
                        </label>

                        <select asp-for="Order.CustomerName"
                                class="form-select">

                            <option value="">
                                -- Select Customer --
                            </option>

                            @foreach (var customer in Model.Customers)
                            {
                                <option value="@customer.Name">
                                    @customer.Name
                                </option>
                            }

                        </select>

                        <span asp-validation-for="Order.CustomerName"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- PRODUCT -->
                    <div class="col-md-6">

                        <label asp-for="Order.ProductName"
                               class="form-label">
                        </label>

                        <select asp-for="Order.ProductName"
                                class="form-select">

                            <option value="">
                                -- Select Product --
                            </option>

                            @foreach (var product in Model.Products)
                            {
                                <option value="@product.Name">
                                    @product.Name
                                    - R @product.Price.ToString("N2")
                                </option>
                            }

                        </select>

                        <span asp-validation-for="Order.ProductName"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- QUANTITY -->
                    <div class="col-md-6">

                        <label asp-for="Order.Quantity"
                               class="form-label">
                        </label>

                        <input asp-for="Order.Quantity"
                               class="form-control"
                               type="number"
                               min="1" />

                        <span asp-validation-for="Order.Quantity"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- TOTAL -->
                    <div class="col-md-6">

                        <label class="form-label">
                            Total Amount
                        </label>

                        <input class="form-control"
                               value="Calculated automatically from product price × quantity"
                               readonly />

                        <div class="form-text">
                            The final amount is calculated when the order is created.
                        </div>

                    </div>


                    <div class="col-12">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-send"></i>
                            Create Order and Send to Queue

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- ORDERS -->
    <div class="card mb-4">

        <div class="card-header bg-secondary text-white">

            <h5 class="mb-0">
                All Orders (@Model.Orders.Count)
            </h5>

        </div>

        <div class="card-body">

            @if (Model.Orders.Any())
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-dark">

                            <tr>
                                <th>Customer</th>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Total Amount</th>
                                <th>Order Date</th>
                                <th>Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var order in
                                                    Model.Orders.OrderByDescending(
                                                    order => order.OrderDate))
                            {
                                <tr>

                                    <td>
                                        @order.CustomerName
                                    </td>

                                    <td>
                                        @order.ProductName
                                    </td>

                                    <td>
                                        @order.Quantity
                                    </td>

                                    <td>
                                        R @order.TotalAmount.ToString("N2")
                                    </td>

                                    <td>
                                        @order.OrderDate.ToString(
                                        "yyyy-MM-dd HH:mm")
                            </td>

                            <td>

                                <form method="post"
                                      asp-page-handler="Delete"
                                      class="d-inline">

                                    <input type="hidden"
                                           name="partitionKey"
                                           value="@order.PartitionKey" />

                                    <input type="hidden"
                                           name="rowKey"
                                           value="@order.RowKey" />

                                    <button type="submit"
                                            class="btn btn-danger btn-sm"
                                            onclick="return confirm('Are you sure you want to delete this order?');">

                                        <i class="bi bi-trash"></i>
                                        Delete

                                    </button>

                                </form>

                            </td>

                        </tr>
                                                }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    No orders found. Create your first order above.
                </div>
            }

        </div>

    </div>


    <!-- AZURE QUEUE -->
    <div class="card">

        <div class="card-header bg-dark text-white">

            <h5 class="mb-0">
                <i class="bi bi-list-task"></i>
                Recent Azure Queue Messages
            </h5>

        </div>

        <div class="card-body">

            @if (Model.QueueMessages.Any())
            {
                <div class="list-group">

                    @foreach (var message in Model.QueueMessages)
                    {
                        <div class="list-group-item">

                            <code class="text-break">
                                @message
                            </code>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    No queue messages currently available.
                </div>
            }

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}