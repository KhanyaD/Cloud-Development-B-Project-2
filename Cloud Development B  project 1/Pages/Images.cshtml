@page
@model Cloud_Development_B__project_1.Pages.ImagesModel

@{
    ViewData["Title"] = "Product Images";
}

<div class="mb-4">

    <h1 class="display-6 fw-bold">
        <i class="bi bi-images text-primary"></i>
        Product Images
    </h1>

    <p class="lead">
        Upload and manage product images using Azure Blob Storage.
    </p>

</div>


@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <i class="bi bi-check-circle-fill me-2"></i>

        @Model.SuccessMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>

    </div>
}


@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        @Model.ErrorMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>

    </div>
}


<!-- UPLOAD SECTION -->

<div class="card mb-4">

    <div class="card-header bg-primary text-white">

        <h5 class="mb-0">
            <i class="bi bi-cloud-arrow-up me-2"></i>
            Upload Product Image
        </h5>

    </div>

    <div class="card-body">

        <form method="post"
              enctype="multipart/form-data">

            <div class="mb-3">

                <label asp-for="ImageFile"
                       class="form-label fw-semibold">

                    Select Image

                </label>

                <input asp-for="ImageFile"
                       type="file"
                       class="form-control"
                       accept=".jpg,.jpeg,.png,.gif,.webp,image/*" />

                <span asp-validation-for="ImageFile"
                      class="text-danger">
                </span>

                <div class="form-text">
                    JPG, PNG, GIF or WEBP. Maximum size: 5 MB.
                </div>

            </div>

            <button type="submit"
                    class="btn btn-primary">

                <i class="bi bi-cloud-arrow-up"></i>
                Upload Image

            </button>

        </form>

    </div>

</div>


<!-- IMAGE GALLERY -->

<div class="card">

    <div class="card-header bg-secondary text-white">

        <h5 class="mb-0">
            <i class="bi bi-images me-2"></i>
            Uploaded Images (@Model.Images.Count)
        </h5>

    </div>

    <div class="card-body">

        @if (Model.Images.Any())
        {
            <div class="row g-4">

                @foreach (var image in Model.Images)
                {
                    <div class="col-lg-3 col-md-4 col-sm-6">

                        <div class="card h-100 shadow-sm">

                            <img src="@image.Url"
                                 class="card-img-top"
                                 alt="@image.DisplayName"
                                 style="height: 200px; object-fit: contain; padding: 10px;" />

                            <div class="card-body d-flex flex-column">

                                <!-- FRIENDLY PRODUCT NAME -->

                                <h6 class="fw-bold text-center mb-3">

                                    @image.DisplayName

                                </h6>


                                <!-- DELETE BUTTON -->

                                <form method="post"
                                      asp-page-handler="Delete"
                                      class="mt-auto text-center">

                                    <!--
                                        IMPORTANT:
                                        Delete still receives the REAL
                                        Azure Blob filename.
                                    -->

                                    <input type="hidden"
                                           name="fileName"
                                           value="@image.FileName" />

                                    <button type="submit"
                                            class="btn btn-danger btn-sm"
                                            onclick="return confirm('Are you sure you want to delete this image?');">

                                        <i class="bi bi-trash"></i>
                                        Delete

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">

                <i class="bi bi-info-circle me-2"></i>

                No product images have been uploaded yet.

            </div>
        }

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}