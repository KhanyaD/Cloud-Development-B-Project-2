@page
@model Cloud_Development_B__project_1.Pages.PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="py-3">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            <p>Use this page to detail your site's privacy policy.</p>
        </div>
    </div>
</div>

<h2 class="h4">Information We Collect</h2>
<p>
    This application collects customer, product, order, and image information only when it is needed
    to provide and manage application services.
</p>

<h2 class="h4 mt-4">How Information Is Used</h2>
<p>
    Information is used to maintain customer records, process orders, manage products, and support
    the daily operation of the application.
</p>

<h2 class="h4 mt-4">Data Security</h2>
<p>
    Application data is stored securely and is available only to authorized users. Information is not
    shared with third parties unless necessary to provide the service or required by law.
</p>

<h2 class="h4 mt-4">Questions</h2>
<p class="mb-0">
    Contact the application administrator if you have questions about how your information is
    collected, used, or stored.
</p>